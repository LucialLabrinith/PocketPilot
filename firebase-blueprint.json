{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and financial preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "full_name": { "type": "string" },
        "currency": { "type": "string" },
        "is_verified": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "full_name", "currency", "is_verified", "created_at", "updated_at"]
    },
    "account": {
      "title": "Account",
      "description": "Financial or bank account record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "account_type": { "type": "string", "enum": ["CHECKING", "SAVINGS", "CASH", "CREDIT_CARD", "INVESTMENT"] },
        "current_balance": { "type": "string" },
        "currency": { "type": "string" },
        "institution": { "type": "string" },
        "is_linked": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "user_id", "name", "account_type", "current_balance", "currency", "created_at", "updated_at"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Financial transaction ledger entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "account_id": { "type": "string" },
        "type": { "type": "string", "enum": ["INCOME", "EXPENSE", "TRANSFER", "REFUND"] },
        "amount": { "type": "string" },
        "transaction_date": { "type": "string", "format": "date-time" },
        "payee": { "type": "string" },
        "is_reconciled": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "user_id", "account_id", "type", "amount", "transaction_date", "created_at", "updated_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile collection partitioned by user ID"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "account",
      "description": "Subcollection of financial accounts owned by the user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Subcollection of transactions belonging to the user"
    }
  }
}
